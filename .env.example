# ==============================================================================
# SKINORA BOTANICAL DISPENSARY & E-COMMERCE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure all variables according to your environment.
# NEVER commit actual passwords, private keys, or webhook secrets to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="Skinora Dispensary"
APP_ENV=production                  # local | testing | staging | production
APP_KEY=                            # Generate via: php artisan key:generate
APP_DEBUG=false                     # MUST be false in production
APP_URL=https://api.skinora.com     # Canonical public API & backend URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Phnom_Penh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING & ERROR MONITORING
# ------------------------------------------------------------------------------
# Options: stack | single | daily | stderr | syslog | errorlog
LOG_CHANNEL=daily
LOG_LEVEL=warning                   # debug | info | notice | warning | error | critical
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Sentry DSN (Optional application performance and exception monitoring)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL DATABASE (TRANSACTION POOLER)
# ------------------------------------------------------------------------------
# For Supabase serverless environments, always connect via the PgBouncer Transaction
# Pooler (Port 6543) with DB_SSLMODE=require. Direct session connection is port 5432.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_secure_database_password
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 4. CORS & API SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Do NOT use '*' in production.
CORS_ALLOWED_ORIGINS="https://skinora.com,https://www.skinora.com,https://admin.skinora.com"
CORS_SUPPORTS_CREDENTIALS=true

# Sanctum Stateful Domains (for SPA session cookie authentication)
SANCTUM_STATEFUL_DOMAINS="skinora.com,www.skinora.com,admin.skinora.com"

# Session cookie domain (prefixed with dot to share across subdomains)
SESSION_DOMAIN=".skinora.com"
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database             # database | redis | file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# ------------------------------------------------------------------------------
# 5. CACHE, QUEUES & TASK SCHEDULING
# ------------------------------------------------------------------------------
CACHE_STORE=database                # database | redis | memcached | file
CACHE_PREFIX=skinora_cache_

QUEUE_CONNECTION=database           # database | redis | sync
# If using Redis for high-throughput queues and caching:
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (ORDER CONFIRMATIONS & DISPATCH)
# ------------------------------------------------------------------------------
# In production, use SMTP, AWS SES, Resend, or Mailgun
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@skinora.com
MAIL_PASSWORD=your_mail_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="apothecary@skinora.com"
MAIL_FROM_NAME="Skinora Dispensary"

# ------------------------------------------------------------------------------
# 7. ASSET STORAGE & FILE DISPATCH
# ------------------------------------------------------------------------------
# Options: public (local disk) | s3 (AWS S3 or Supabase Storage S3-compatible)
FILESYSTEM_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=skinora-formulation-assets
AWS_URL=https://skinora-formulation-assets.s3.ap-southeast-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY CREDENTIALS (PRODUCTION / SANDBOX)
# ------------------------------------------------------------------------------
# Credit / Debit Card (Stripe Gateway)
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Bakong KHQR (National Bank of Cambodia Payment Gateway)
BAKONG_MERCHANT_ID=SKINORA_DISPENSARY_LAB
BAKONG_MERCHANT_NAME="Skinora Dispensary"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_API_KEY=your_bakong_merchant_api_token
BAKONG_API_URL=https://api-bakong.nbc.org.kh/v1

# ------------------------------------------------------------------------------
# 9. TELEMETRY & DIAGNOSTICS (DISABLED IN PRODUCTION)
# ------------------------------------------------------------------------------
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# ------------------------------------------------------------------------------
# 10. FRONTEND REPOSITORY SYNC (.env in Frontend_SkinCare_Ecommerce)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=https://api.skinora.com/api/v1
# VITE_APP_NAME="Skinora Clinical Dispensary"
